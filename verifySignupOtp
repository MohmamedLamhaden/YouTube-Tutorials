import 'package:supabase_flutter/supabase_flutter.dart';

Future<String> verifySignupOtp(String email, String token) async {
  final supabase = Supabase.instance.client;
  final trimmedEmail = email.trim();
  final trimmedToken = token.trim();

  if (trimmedToken.isEmpty) {
    return "invalid_code";
  }

  try {
    final response = await supabase.auth.verifyOTP(
      type: OtpType.signup,
      email: trimmedEmail,
      token: trimmedToken,
    );
    if (response.session != null) {
      return "success";
    } else {
      return "invalid_code";
    }
  } on AuthException catch (e) {
    print("AUTH ERROR (signup verify): ${e.message} | statusCode: ${e.statusCode}");
    return "invalid_code";
  } catch (e) {
    print("UNEXPECTED ERROR (signup verify): $e");
    return "error";
  }
}
