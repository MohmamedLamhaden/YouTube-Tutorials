<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your verification code</title>
</head>

<body style="margin:0; padding:0; background:#f5f5f5; font-family:Arial, sans-serif;">

  <div style="max-width:480px; margin:40px auto; background:#ffffff; padding:40px 30px; border-radius:12px; text-align:center;">

    <h2 style="margin:0 0 15px; color:#111111;">
      Verify your email
    </h2>

    <p style="margin:0 0 25px; color:#555555; font-size:15px;">
      Use the verification code below to continue.
    </p>

    <div style="display:inline-block; padding:15px 25px; background:#f0f0f0; border-radius:8px; font-size:32px; font-weight:bold; letter-spacing:8px; color:#111111;">
      {{ .Token }}
    </div>

    <p style="margin:25px 0 0; color:#777777; font-size:13px;">
      This code will expire soon. If you didn't request this code, you can safely ignore this email.
    </p>

  </div>

</body>
</html>
